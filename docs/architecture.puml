@startuml ORRALI_Architecture_v6_3
!theme plain
skinparam backgroundColor #F8F6F1
skinparam defaultFontName Arial
skinparam packageBackgroundColor #FFFFFF
skinparam packageBorderColor #1B1536
skinparam componentStyle uml2

title ORRALI Architecture (Version 6.4.0 — Learning Intelligence Foundation)

package "Presentation & UI Layer (React Native / Expo)" {
  [App.tsx
Root Orchestrator] as App
  
  package "Screens & Dashboards" {
    [HomeScreen
Word of Day, Path & Hub] as HomeScreen
    [ProgressScreen
Journey & Course XP] as ProgressScreen
    [ProfileScreen
Diplomas, Cloud Sync & Goals] as ProfileScreen
    [LessonScreen
Sentence Anatomy, Turtle Audio & Speech Lab] as LessonScreen
  }

  package "Interactive Modals" {
    [PlacementTestModal
Adaptive CEFR Placement & Fast-Track] as PlacementModal
    [CafeLibraryModal
Tap-to-Read Stories & Audiobooks] as CafeModal
    [ShadowStudioModal
Mimicry Studio & Accent Tuning] as ShadowModal
    [VerbGymModal
Conjugation Slot-Machine] as VerbGymModal
    [ExpressReviewModal
3-Minute Fast-Track SM-2 Deck] as ExpressModal
    [RadioLabModal
Audio Dictation & Liaisons] as RadioModal
    [CommuterAudioModal
Hands-Free Pimsleur Audio Loop] as CommuterModal
    [MilestoneExamModal
CEFR Milestone Exams] as MilestoneModal
    [SpeedRecallModal
60s Speed Arcade] as SpeedModal
    [LexiconModal
Smart Search & Dual-Speed Flashcards] as LexiconModal
    [TutorModal
Ask ORRALI Tutor] as TutorModal
    [MistakeClinicModal
Smart Mistake Clinic] as ClinicModal
    [RoleplayModal
Conversational Simulation] as RoleplayModal
  }
}

package "Sentence Anatomy & Commuter Engines" {
  [placement.ts
Adaptive CEFR & State Mutation] as PlacementEngine
  [cafeLibrary.ts
Cultural Stories & Tap Tokenizer] as CafeEngine
  [shadowStudio.ts
Mimicry Deck & Phonetic Evaluation] as ShadowEngine
  [verbs.ts
Conjugation Tables & Evaluation] as VerbEngine
  [expressReview.ts
SM-2 Urgent Extraction] as ExpressEngine
  [radioLab.ts
Dictation Cloze & Connected Speech] as RadioEngine
  [commuterAudio.ts
Hands-Free Sequencing & Queue] as CommuterEngine
  [gender.ts
Chromatic Gender Immersion] as GenderEngine
  [anatomy.ts
Sentence Anatomy & Word Breakdown] as AnatomyEngine
  [wordOfDay.ts
Daily Idiom Pool & Micro-Spark] as WordOfDayEngine
  [milestones.ts
Milestone Exams & CEFR Diplomas] as MilestoneEngine
  [speedRecall.ts
Speed Arcade & Combo Streaks] as SpeedEngine
}

package "Smart Lexicon & Flashcard Engine" {
  [lexicon.ts
Search, Mastery Filters & Flip Deck] as LexiconEngine
}

package "Sensory Polish, Haptics & Themes" {
  [sensory.ts
expo-haptics Tactile Engine] as SensoryEngine
  [theme.ts
Velvet Midnight OLED Palette] as ThemeEngine
}

package "AI Companion Engine (src/companion/)" {
  [clinic.ts
Error Diagnosis & Remediation] as ClinicEngine
  [tutor.ts
Knowledge Base & Rules] as TutorEngine
  [roleplay.ts
Multi-turn State Machine (FR/DE/ES)] as RoleplayEngine
}

package "Domain & Pedagogical Engine" {
  [exercises.ts
Sentence Scramble, Distractors & Evaluation] as Exercises
  [scoring.ts
Fuzzy Token Alignment & Leniency Engine] as Scoring
  [cloudSync.ts
Google Drive Checksum & Conflict Resolution] as CloudSync
  [notifications.ts
Offline Streak & Shield Reminders] as Notifications
  [srs.ts
SM-2 with Lapse Tracking] as SRS
  [badges.ts
Achievement Evaluation] as Badges
  [streak.ts
Streak Shields & Freeze] as Streak
  [content/ (Modular Courses)
Scalable CEFR A1-B2 Units & Stories] as Content
  [store.ts
Dual-Write Repository] as Store
}

package "Audio Engine & Acoustic Harmony" {
  [audio.ts
expo-audio Playback & Recording] as AudioEngine
  [audioSpeed.ts
Dual-Speed Rate Engine (Normal & Turtle)] as AudioSpeed
  [audioMap.ts
360 Pre-Rendered Studio MP3s] as AudioMap
  [earcons.ts
Acoustic Chimes & Victory Fanfare] as EarconEngine
}

package "Offline Persistence Layer" {
  database "SQLite (expo-sqlite)
progress_store, attempts & learning_events" as SQLiteDB
  database "AsyncStorage (Backup)" as AsyncBackup
}

package "Learning Intelligence & Telemetry Engine (Phase 1)" {
  [events.ts
Standardized Learning Events & Error Taxonomy] as LearningEvents
  [learnerModel.ts
Multi-Domain Knowledge Profiles & Decoupled Mastery] as LearnerModel
  [recommendations.ts
Explainable Recommender & Session Generator] as Recommender
}

package "Real-World Communication Engine (Phase 2 & 3)" {
  [missions/engine.ts
Branching Missions & Multi-Metric Scoring] as MissionsEngine
  [missions/catalog.ts
Travel, Everyday & Professional Catalog] as MissionsCatalog
  [MissionModal.tsx
5-Stage Interactive Mission Modal] as MissionModalView
  [writing/engine.ts
Writing Correction Engine & 8-Point Feedback] as WritingEngine
  [writing/catalog.ts
Multi-Format Writing Catalog] as WritingCatalog
  [WritingLabModal.tsx
Interactive Writing Desk Modal] as WritingLabModalView
}

package "Visual Personas & Emotion Engine (Phase 7.2)" {
  [personas/roster.ts
European Triad Character Personas] as PersonaRoster
  [personas/emotionEngine.ts
Performance-Driven Emotion Engine & Tiers] as EmotionEngine
  [personas/VisualAvatar.tsx
Visual Portrait & Animated Mood Ring] as VisualAvatarView
}

package "Interactive 2D World Map (Phase 7.3)" {
  [world/environmentEngine.ts
Day/Night Cycle & Discovery Progress] as WorldEnvironmentEngine
  [world/cityCatalog.ts
European Triad Spatial City Map] as CityMapCatalog
  [world/WorldMapView.tsx
Interactive 2D Spatial City Map Canvas] as WorldMapView
}

package "Generative Emotional TTS (Phase 7.4)" {
  [audio/emotionalTts.ts
Emotional Prosody Shaping & Persona Voices] as EmotionalTtsEngine
}

' Navigation & Screen Wiring
App --> HomeScreen
App --> ProgressScreen
App --> ProfileScreen
App --> LessonScreen
App --> ThemeEngine

HomeScreen --> MilestoneModal
HomeScreen --> SpeedModal
HomeScreen --> LexiconModal
HomeScreen --> TutorModal
HomeScreen --> ClinicModal
HomeScreen --> RoleplayModal
HomeScreen --> WordOfDayEngine
HomeScreen --> MissionModalView
HomeScreen --> WritingLabModalView
HomeScreen --> WorldMapView

' Modals to Engines
MilestoneModal --> MilestoneEngine
SpeedModal --> SpeedEngine
SpeedModal --> EarconEngine
SpeedModal --> SensoryEngine
LexiconModal --> LexiconEngine
LexiconModal --> AudioEngine
ClinicModal --> ClinicEngine
TutorModal --> TutorEngine
RoleplayModal --> RoleplayEngine
RoleplayModal --> VisualAvatarView
VisualAvatarView --> EmotionEngine
EmotionEngine --> PersonaRoster
MissionModalView --> MissionsEngine
MissionModalView --> EmotionalTtsEngine
RoleplayModal --> EmotionalTtsEngine
MissionsEngine --> MissionsCatalog
MissionsEngine --> LearningEvents
WritingLabModalView --> WritingEngine
WritingEngine --> WritingCatalog
WritingEngine --> LearningEvents
WorldMapView --> WorldEnvironmentEngine
WorldMapView --> CityMapCatalog

' Screen to Domain
LessonScreen --> Exercises
LessonScreen --> Scoring
LessonScreen --> AnatomyEngine
LessonScreen --> AudioEngine
LessonScreen --> AudioSpeed
LessonScreen --> EarconEngine
LessonScreen --> SensoryEngine
ProfileScreen --> ThemeEngine
ProfileScreen --> SensoryEngine
ProfileScreen --> CloudSync

' Domain to Persistence
Store --> SQLiteDB
Store --> AsyncBackup
Exercises --> Content
AudioEngine --> AudioMap
AudioEngine --> AudioSpeed
SRS --> Store
App --> LearningEvents
LearningEvents --> LearnerModel
LearningEvents --> SQLiteDB
LearnerModel --> SQLiteDB
LearnerModel --> Recommender
Recommender --> HomeScreen

@enduml
