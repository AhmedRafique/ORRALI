@startuml Lesson_Flow_and_Checkpoint_Lifecycle
!theme plain
skinparam backgroundColor #F8F6F1
skinparam defaultFontName Arial
skinparam sequenceParticipantBackgroundColor #FFFFFF
skinparam sequenceParticipantBorderColor #1B1536

title Lesson Flow, Scaffolding & Resumption Checkpoint (ORRALI 1.3.1)

actor Learner
participant "HomeScreen" as Home
participant "App (Root)" as App
participant "LessonScreen" as Lesson
participant "audio.ts" as Audio
participant "store.ts / SQLite" as Storage

== Chapter Launch & Checkpoint Detection ==
Learner -> Home : Tap chapter card (startLesson)
Home -> App : startLesson(lessonId)
alt Checkpoint exists (exerciseIndex > 0)
  App -> Learner : Show Resume Modal ("Continue from Step X" vs "Start from Beginning")
  alt Learner chooses "Continue from Step X"
    Learner -> App : Resume
    App -> Lesson : Mount with initialIndex, initialCorrectIds, initialWrongIds
  else Learner chooses "Start from Beginning"
    Learner -> App : Start from Beginning
    App -> Storage : Delete checkpoint for lessonId
    App -> Lesson : Mount at initialIndex = 0
  end
else No Checkpoint
  App -> Lesson : Mount at initialIndex = 0
end

== Pedagogical Scaffolding & Audio Lifecycle ==
alt Step is 'intro' card
  Lesson -> Audio : Auto-play phrase with native neural voice
  Learner -> Lesson : Tap "I understand · Continue"
  Lesson -> Storage : Auto-save checkpoint(nextIndex)
else Step is 'choice' / 'listen' / 'type'
  Learner -> Lesson : Enter or select translation
  Lesson -> Lesson : evaluateAnswer(given, item) [Variants + Accent-leniency + Typos]
  alt Correct or Close
    Lesson -> Audio : Play pronunciation & show supportive tip
    Lesson -> Storage : Auto-save checkpoint(currentIndex, correctIds, wrongIds)
  else Incorrect
    Lesson -> Lesson : Record in wrongIds & show constructive feedback
  end
  Learner -> Lesson : Tap "Continue"
  Lesson -> Storage : Auto-save checkpoint(nextIndex)
end

== Early Exit (Mid-Lesson Pause) ==
opt Learner presses "×" or Android Back button
  Learner -> Lesson : Exit action
  Lesson -> Learner : Confirmation alert ("Your progress is saved up to this step.")
  Learner -> Lesson : Confirm Leave
  Lesson -> Storage : Persist Checkpoint(lessonId, index, correctIds, wrongIds)
  Lesson -> App : onExit() -> Return to Home
end

== Lesson Finish & Checkpoint Clearance ==
Learner -> Lesson : Complete final exercise & tap "Finish lesson"
Lesson -> App : onFinish({ correctIds, wrongIds })
App -> Storage : Clear checkpoint for lessonId
App -> Storage : Update XP, courseXp, streak, completed chapters & SM-2 cards
App -> Home : Return to Home with completed status

@enduml
