{
  "name": "orrali",
  "version": "5.6.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~58.0.25",
    "expo-audio": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-speech": "~58.0.4",
    "expo-speech-recognition": "^58.0.1",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/__tests__/**/*.test.ts",
    "export:items": "tsx -e \"import { courses } from './src/content'; import * as fs from 'fs'; const items = courses.flatMap(c => c.lessons.flatMap(l => l.items)).map(i => ({ id: i.id, target: i.target, en: i.en })); fs.writeFileSync('scripts/items.json', JSON.stringify(items, null, 2), 'utf-8'); console.log('Exported', items.length, 'items');\"",
    "build:preview": "eas build --platform android --profile preview"
  },
  "private": true
}
